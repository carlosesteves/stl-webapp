# Runs the app on your machine against the PRODUCTION Supabase database.
# Use the session pooler (port 5432); URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Local http cannot send Secure cookies in every browser
COOKIE_SECURE=false
